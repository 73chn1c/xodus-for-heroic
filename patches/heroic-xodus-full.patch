+import CacheStore from 'backend/cache'
+import { TypeCheckedStoreBackend } from 'backend/electron_store'
+import { GameInfo } from 'common/types'
+import { XodusCatalogEntry, XodusInstallInfo } from 'common/types/xodus'
+
+export const installStore = new CacheStore<XodusInstallInfo>(
+  'xodus_install_info'
+)
+export const libraryStore = new CacheStore<GameInfo[], 'library'>(
+  'xodus_library',
+  null
+)
+
+// The parsed `xodus-cli catalog` rows (name + storeId only, no art - that's
+// cached separately in art.ts). Catalog composition changes rarely enough
+// that re-running the real `catalog` subprocess (which itself makes several
+// real network calls to resolve title names in batches) on every single
+// catalog screen open isn't worth it - 6h matches the TTL convention other
+// store managers use for their own "list of everything" API caches (e.g.
+// gog's `apiInfoCache`).
+export const catalogStore = new CacheStore<XodusCatalogEntry[], 'entries'>(
+  'xodus_catalog',
+  60 * 6
+)
+
+export const configStore = new TypeCheckedStoreBackend('xodusConfigStore', {
+  cwd: 'xodus_store'
+})
diff --git a/src/backend/storeManagers/xodus/games.ts b/src/backend/storeManagers/xodus/games.ts
new file mode 100644
index 0000000..1c1d226
--- /dev/null
+++ b/src/backend/storeManagers/xodus/games.ts
@@ -0,0 +1,460 @@
+import { existsSync, rmSync } from 'graceful-fs'
+
+import {
+  ExecResult,
+  ExtraInfo,
+  GameInfo,
+  GameSettings,
+  InstallArgs,
+  InstallProgress,
+  LaunchOption
+} from 'common/types'
+import { Game, InstallResult } from 'common/types/game_manager'
+import { libraryManagerMap } from '..'
+import {
+  LogPrefix,
+  logError,
+  logInfo,
+  createGameLogWriter
+} from 'backend/logger'
+import { GameConfig } from 'backend/game_config'
+import { GlobalConfig } from 'backend/config'
+import {
+  killPattern,
+  moveOnUnix,
+  moveOnWindows,
+  sendGameStatusUpdate,
+  sendProgressUpdate
+} from 'backend/utils'
+import {
+  addShortcuts as addShortcutsUtil,
+  removeShortcuts as removeShortcutsUtil
+} from '../../shortcuts/shortcuts/shortcuts'
+import { removeNonSteamGame } from 'backend/shortcuts/nonesteamgame/nonesteamgame'
+import { sendFrontendMessage } from '../../ipc'
+import { isWindows } from 'backend/constants/environment'
+import { getExecutablesFromMicrosoftGameConfig } from './parsing'
+
+import type LogWriter from 'backend/logger/log_writer'
+
+export default class XodusGame implements Game {
+  private readonly id: string
+
+  constructor(id: string) {
+    this.id = id
+  }
+
+  async getSettings(): Promise<GameSettings> {
+    const gameConfig = GameConfig.get(this.id)
+    return gameConfig.config || (await gameConfig.getSettings())
+  }
+
+  getGameInfo(): GameInfo {
+    const info = libraryManagerMap['xodus'].getGameInfo(this.id)
+    if (!info) {
+      logError(
+        [
+          'Could not get game info for',
+          `${this.id},`,
+          'returning empty object'
+        ],
+        LogPrefix.Xodus
+      )
+      return {
+        app_name: this.id,
+        runner: 'xodus',
+        art_cover: '',
+        art_square: '',
+        install: {},
+        is_installed: false,
+        title: '',
+        canRunOffline: false
+      }
+    }
+    return info
+  }
+
+  async getExtraInfo(): Promise<ExtraInfo> {
+    return { reqs: [] }
+  }
+
+  /* eslint-disable-next-line @typescript-eslint/no-unused-vars */
+  async importGame(folderPath: string): Promise<ExecResult> {
+    // Game Pass doesn't support importing an arbitrary pre-existing install
+    // the way Amazon/nile does - every title is tied to xodus-cli's own
+    // streaming+decrypt pipeline (see run.rs: `run` re-reads the
+    // `.xodus-streaming.msixvc` package left behind by `streaming` to
+    // decrypt executables at launch time), so there's nothing to "import".
+    return {
+      stdout: '',
+      stderr: '',
+      error: 'Importing existing installs is not supported for the xodus store'
+    }
+  }
+
+  private defaultTmpProgress = (): InstallProgress => ({
+    bytes: '',
+    eta: '',
+    percent: undefined,
+    diskSpeed: undefined,
+    downSpeed: undefined
+  })
+  private tmpProgress: InstallProgress | undefined = undefined
+
+  /**
+   * Best-effort install progress parsing.
+   *
+   * xodus-cli's `streaming` command renders its progress with `indicatif`
+   * (see crates/xodus-cli/src/commands/streaming.rs), using the template
+   * `"{msg:30!} {bytes:>12}/{total_bytes:>12} {bytes_per_sec:>12}
+   * [{bar:40.cyan/blue}] {percent:>3}%"`. That's a live terminal progress
+   * bar (relies on carriage returns / ANSI, and indicatif suppresses/alters
+   * rendering entirely when stdout/stderr isn't a TTY, which is the case
+   * for Heroic's piped `child_process.spawn`) rather than clean structured
+   * log lines like nile's. This is a coarse best-effort parse of whatever
+   * percentage text does make it through - if xodus-cli renders nothing on
+   * a non-TTY pipe, this will simply never fire and the UI will just show
+   * an indeterminate "installing" state, which is an acceptable v1 gap
+   * (see task scope: "a coarser progress signal is fine for v1").
+   */
+  onInstallOrUpdateOutput(action: 'installing' | 'updating', data: string) {
+    if (!this.tmpProgress) {
+      this.tmpProgress = this.defaultTmpProgress()
+    }
+    const progress = this.tmpProgress
+
+    const percentMatches = [...data.matchAll(/(\d{1,3})\s*%/g)]
+    if (percentMatches.length) {
+      const last = percentMatches[percentMatches.length - 1][1]
+      const value = Number(last)
+      if (!Number.isNaN(value)) {
+        progress.percent = Math.min(100, Math.max(0, value))
+      }
+    }
+
+    const bytesMatch = data.match(
+      /([\d.]+\s?[KMGT]i?B)\s*\/\s*([\d.]+\s?[KMGT]i?B)/
+    )
+    if (bytesMatch) {
+      progress.bytes = bytesMatch[1]
+    }
+
+    if (progress.percent !== undefined) {
+      sendProgressUpdate({
+        appName: this.id,
+        runner: 'xodus',
+        status: action,
+        progress
+      })
+    }
+  }
+
+  async install({ path }: InstallArgs): Promise<InstallResult> {
+    const gameInfo = this.getGameInfo()
+
+    const commandParts = ['streaming', this.id, path]
+
+    const onOutput = (data: string) => {
+      this.onInstallOrUpdateOutput('installing', data)
+    }
+
+    const installLogWriter = await createGameLogWriter(
+      this.id,
+      'xodus',
+      'install'
+    )
+    const res = await libraryManagerMap['xodus'].runRunnerCommand(
+      commandParts,
+      {
+        abortId: this.id,
+        logWriters: [installLogWriter],
+        onOutput,
+        logMessagePrefix: `Installing ${gameInfo.title}`
+      }
+    )
+
+    if (res.abort) {
+      return { status: 'abort' }
+    }
+
+    if (res.error) {
+      logError(['Failed to install', this.id, res.error], LogPrefix.Xodus)
+      return { status: 'error', error: res.error }
+    }
+
+    const executables = getExecutablesFromMicrosoftGameConfig(path)
+
+    libraryManagerMap['xodus'].setInstallMetadata({
+      id: this.id,
+      storeId: this.id,
+      version: '',
+      path,
+      executable: executables[0]
+    })
+    libraryManagerMap['xodus'].installState(this.id, true)
+
+    this.addShortcuts()
+
+    return { status: 'done' }
+  }
+
+  isNative(): boolean {
+    // Game Pass PC content is Windows-only and this whole store exists to
+    // run it on Linux through xodus's custom Wine/GDK fork - there is no
+    // "native" codepath, unlike nile which can pass Windows builds through
+    // untouched when Heroic itself is running on Windows.
+    return false
+  }
+
+  async addShortcuts(fromMenu?: boolean) {
+    return addShortcutsUtil(this, fromMenu)
+  }
+
+  async removeShortcuts() {
+    return removeShortcutsUtil(this)
+  }
+
+  /**
+   * Resolves which executable to hand to `xodus-cli run --exe`.
+   *
+   * xodus-cli's own default-exe-picking in `run` isn't reliable for titles
+   * with multiple executables (a known, real xodus-cli bug - see run.rs:
+   * it just takes the first `keep_encrypted` file it iterates over when no
+   * `--exe` is given, with no notion of "this is the main one"). We read
+   * `MicrosoftGame.config`'s `<ExecutableList>` ourselves instead of
+   * trusting that.
+   */
+  private resolveExecutable(
+    installPath: string,
+    launchArguments?: LaunchOption,
+    gameSettings?: GameSettings
+  ): string | undefined {
+    if (launchArguments?.type === 'altExe') {
+      return launchArguments.executable
+    }
+    if (gameSettings?.targetExe) {
+      return gameSettings.targetExe
+    }
+
+    const metadata = libraryManagerMap['xodus'].getInstallMetadata(this.id)
+    if (metadata?.executable) {
+      return metadata.executable
+    }
+
+    const executables = getExecutablesFromMicrosoftGameConfig(installPath)
+    if (executables.length) {
+      if (executables.length > 1) {
+        logInfo(
+          [
+            'Multiple executables found in MicrosoftGame.config for',
+            this.id,
+            '- picking the first one:',
+            executables[0],
+            'Use the "Alternative executable" setting to override.'
+          ],
+          LogPrefix.Xodus
+        )
+      }
+      return executables[0]
+    }
+
+    logInfo(
+      [
+        'No MicrosoftGame.config executable found for',
+        this.id,
+        '- letting xodus-cli run pick its own default'
+      ],
+      LogPrefix.Xodus
+    )
+    return undefined
+  }
+
+  async launch(
+    logWriter: LogWriter,
+    launchArguments?: LaunchOption,
+    args: string[] = []
+  ): Promise<boolean> {
+    const gameInfo = this.getGameInfo()
+    const gameSettings = await this.getSettings()
+    const { install_path } = gameInfo.install
+
+    if (!install_path || !existsSync(install_path)) {
+      logWriter.logError(['Cannot launch, install path not found for', this.id])
+      return false
+    }
+
+    let { xodusWineBin } = GlobalConfig.get().getSettings()
+    if (!xodusWineBin) {
+      if (gameSettings?.wineVersion?.bin) {
+        xodusWineBin = gameSettings.wineVersion.bin
+      } else {
+        xodusWineBin = 'wine'
+      }
+    }
+
+    const exe = this.resolveExecutable(
+      install_path,
+      launchArguments,
+      gameSettings
+    )
+    const exeFlag = exe ? ['--exe', exe] : []
+
+    sendGameStatusUpdate({
+      appName: this.id,
+      runner: 'xodus',
+      status: 'playing'
+    })
+
+    const { error } = await libraryManagerMap['xodus'].runRunnerCommand(
+      ['run', install_path, xodusWineBin, ...exeFlag, ...args],
+      {
+        abortId: this.id,
+        logMessagePrefix: `Launching ${gameInfo.title}`,
+        logWriters: [logWriter]
+      }
+    )
+
+    if (error) {
+      logError(['Error launching game:', error], LogPrefix.Xodus)
+    }
+
+    sendGameStatusUpdate({
+      appName: this.id,
+      runner: 'xodus',
+      status: 'done'
+    })
+
+    return !error
+  }
+
+  async moveInstall(newInstallPath: string): Promise<InstallResult> {
+    const gameInfo = this.getGameInfo()
+    logInfo(`Moving ${gameInfo.title} to ${newInstallPath}`, LogPrefix.Xodus)
+
+    const moveImpl = isWindows ? moveOnWindows : moveOnUnix
+    const moveResult = await moveImpl(newInstallPath, gameInfo)
+
+    if (moveResult.status === 'error') {
+      const { error } = moveResult
+      logError(
+        ['Error moving', gameInfo.title, 'to', newInstallPath, error],
+        LogPrefix.Xodus
+      )
+      return { status: 'error', error }
+    }
+
+    await libraryManagerMap['xodus'].changeGameInstallPath(
+      this.id,
+      moveResult.installPath
+    )
+    return { status: 'done' }
+  }
+
+  /**
+   * xodus-cli has no dedicated `verify`/`repair` subcommand, but `streaming`
+   * (the same command `install()`/`update()` already use) is naturally
+   * hash-diff safe against an existing install - confirmed by reading its
+   * real implementation (`crates/xodus-cli/src/commands/streaming.rs` in
+   * `/home/technic/xodus`, read-only reference, not modified here):
+   * `run_reader()` opens the existing `.xodus-streaming.msixvc` at the
+   * destination (if present), parses its segment metadata, and only
+   * re-downloads segments whose `data_hashs` don't match the remote
+   * package's (or are missing locally) - see the two `.filter(|(k, v1)| ...
+   * v1.data_hashs != v2.data_hashs ...)` blocks. So re-running `streaming`
+   * against the same install dir IS a real verify+repair: unchanged files
+   * are left alone, corrupted/missing ones get re-fetched. This delegates
+   * to the exact same `install()` path `update()` already uses for that
+   * reason, rather than duplicating the `streaming` invocation - any real
+   * failure (network error, license fetch failure, etc) propagates as a
+   * real error rather than being reported as a fabricated success.
+   */
+  async repair(): Promise<ExecResult> {
+    const gameInfo = this.getGameInfo()
+    const { install_path } = gameInfo.install
+
+    if (!install_path || !existsSync(install_path)) {
+      const error = `Cannot repair ${gameInfo.title}: no known install path found`
+      logError(error, LogPrefix.Xodus)
+      return { stdout: '', stderr: '', error }
+    }
+
+    logInfo(
+      `Repairing ${gameInfo.title} by re-verifying its streamed package against ${install_path}`,
+      LogPrefix.Xodus
+    )
+
+    const result = await this.install({
+      path: install_path,
+      platformToInstall: 'Windows'
+    })
+
+    if (result.status === 'error') {
+      return {
+        stdout: '',
+        stderr: '',
+        error: result.error ?? 'Unknown error while repairing'
+      }
+    }
+    if (result.status === 'abort') {
+      return { stdout: '', stderr: '', error: 'Repair was aborted' }
+    }
+
+    return { stdout: 'Repair completed', stderr: '' }
+  }
+
+  async syncSaves(): Promise<string> {
+    // Xbox Game Pass PC doesn't expose cloud saves through xodus-cli
+    return ''
+  }
+
+  async uninstall(): Promise<ExecResult> {
+    const gameInfo = this.getGameInfo()
+    const { install_path } = gameInfo.install
+
+    if (install_path && existsSync(install_path)) {
+      try {
+        rmSync(install_path, { recursive: true, force: true })
+      } catch (error) {
+        const message = `Failed to remove ${install_path}: ${error}`
+        logError(message, LogPrefix.Xodus)
+        return { stdout: '', stderr: '', error: message }
+      }
+    }
+
+    libraryManagerMap['xodus'].removeFromInstalledConfig(this.id)
+    libraryManagerMap['xodus'].installState(this.id, false)
+    await removeShortcutsUtil(this)
+    await removeNonSteamGame(this)
+
+    sendFrontendMessage('refreshLibrary', 'xodus')
+    return { stdout: '', stderr: '' }
+  }
+
+  async update(): Promise<InstallResult> {
+    // Game Pass titles don't have incremental patches through xodus-cli -
+    // "updating" means re-streaming the package to the same path.
+    const gameInfo = this.getGameInfo()
+    const { install_path } = gameInfo.install
+    if (!install_path) {
+      return { status: 'error', error: 'No install path found' }
+    }
+    return this.install({ path: install_path, platformToInstall: 'Windows' })
+  }
+
+  async forceUninstall() {
+    libraryManagerMap['xodus'].removeFromInstalledConfig(this.id)
+  }
+
+  async stop() {
+    killPattern(this.id)
+  }
+
+  async isGameAvailable(): Promise<boolean> {
+    const info = this.getGameInfo()
+    return Boolean(
+      info?.is_installed &&
+      info.install.install_path &&
+      existsSync(info.install.install_path)
+    )
+  }
+}
diff --git a/src/backend/storeManagers/xodus/library.ts b/src/backend/storeManagers/xodus/library.ts
new file mode 100644
index 0000000..5b8b486
--- /dev/null
+++ b/src/backend/storeManagers/xodus/library.ts
@@ -0,0 +1,422 @@
+import { existsSync, readFileSync, writeFileSync, mkdirSync } from 'graceful-fs'
+import { join } from 'path'
+
+import {
+  LogPrefix,
+  logDebug,
+  logError,
+  logInfo,
+  logWarning
+} from 'backend/logger'
+import { CallRunnerOptions, ExecResult, GameInfo } from 'common/types'
+import {
+  XodusCatalogEntry,
+  XodusInstallInfo,
+  XodusInstallMetadataInfo
+} from 'common/types/xodus'
+import { callRunner } from 'backend/launcher'
+import { getXodusBin } from 'backend/utils'
+import type { LibraryManager } from 'common/types/game_manager'
+
+import {
+  catalogStore,
+  configStore,
+  installStore,
+  libraryStore
+} from './electronStores'
+import { xodusConfigPath, xodusInstalled } from './constants'
+import { parseXodusCatalogOutput, parseXodusLibraryOutput } from './parsing'
+import { getArtForStoreIds } from './art'
+import XodusGame from './games'
+
+export default class XodusLibraryManager implements LibraryManager {
+  private installedGames: Map<string, XodusInstallMetadataInfo> = new Map()
+  private library: Map<string, GameInfo> = new Map()
+  private readonly gameCache: Map<string, XodusGame> = new Map()
+
+  async init() {
+    if (!existsSync(xodusConfigPath)) {
+      mkdirSync(xodusConfigPath, { recursive: true })
+    }
+    await this.refresh()
+  }
+
+  getGame(id: string): XodusGame {
+    const cached = this.gameCache.get(id)
+    if (cached) return cached
+
+    const game = new XodusGame(id)
+    this.gameCache.set(id, game)
+    return game
+  }
+
+  /**
+   * Reloads `installedGames` from `installed.json` on disk.
+   */
+  refreshInstalled() {
+    this.installedGames.clear()
+    if (existsSync(xodusInstalled)) {
+      try {
+        const installed: XodusInstallMetadataInfo[] = JSON.parse(
+          readFileSync(xodusInstalled, 'utf-8')
+        )
+        installed.forEach((metadata) => {
+          this.installedGames.set(metadata.storeId, metadata)
+        })
+      } catch (error) {
+        logError(
+          ['Corrupted installed.json file, cannot load installed games', error],
+          LogPrefix.Xodus
+        )
+      }
+    }
+  }
+
+  getInstallMetadata(appName: string): XodusInstallMetadataInfo | undefined {
+    this.refreshInstalled()
+    return this.installedGames.get(appName)
+  }
+
+  private writeInstalled() {
+    writeFileSync(
+      xodusInstalled,
+      JSON.stringify(Array.from(this.installedGames.values())),
+      'utf-8'
+    )
+  }
+
+  /**
+   * Persists a newly-installed (or updated) game's metadata to
+   * installed.json and refreshes in-memory state accordingly.
+   */
+  setInstallMetadata(metadata: XodusInstallMetadataInfo) {
+    this.refreshInstalled()
+    this.installedGames.set(metadata.storeId, metadata)
+    this.writeInstalled()
+  }
+
+  removeFromInstalledConfig(appName: string) {
+    this.refreshInstalled()
+    this.installedGames.delete(appName)
+    this.writeInstalled()
+  }
+
+  /**
+   * Loads the account's real Game Pass library (title history + resolved
+   * store ids) from `xodus-cli library` into `this.library` as GameInfo
+   * objects. Entries whose store id couldn't be resolved (printed as "?" by
+   * xodus-cli) are still shown for visibility but flagged `installable:
+   * false`, since both `streaming` and `run` need a real store id.
+   */
+  async refresh(): Promise<ExecResult | null> {
+    logInfo('Refreshing xodus library...', LogPrefix.Xodus)
+
+    const res = await this.runRunnerCommand(['library'], {
+      abortId: 'xodus-refresh'
+    })
+
+    // `callRunner`/`ExecResult.error` is only ever populated for
+    // spawn-level failures (binary not found, killed by signal, etc) - a
+    // normal non-zero exit with a message on stderr (which is exactly how
+    // xodus-cli reports "not logged in") leaves `.error` unset. Verified
+    // directly against a real unauthenticated run: `xodus-cli library`
+    // prints `Not logged in - run \`xodus-cli login\` first` to stderr and
+    // produces no usable stdout table, so treat missing/header-only stdout
+    // as a failure too and surface stderr as the reason.
+    if (res.error || !res.stdout.trim()) {
+      const message =
+        res.error ||
+        res.stderr.trim() ||
+        'Unknown error refreshing xodus library'
+      logWarning(['Failed to refresh xodus library:', message], LogPrefix.Xodus)
+      // Most commonly: not logged in yet, or altXodusBin isn't configured.
+      // Not fatal - leave whatever was loaded from cache/previous refresh.
+      // A failed `library` call is also the only signal we have of login
+      // state (xodus-cli has no separate "whoami"/"status" subcommand).
+      configStore.set('loggedIn', false)
+      return { ...res, error: message }
+    }
+
+    configStore.set('loggedIn', true)
+    this.refreshInstalled()
+
+    const entries = parseXodusLibraryOutput(res.stdout)
+
+    // Real cover/logo/background art - xodus-cli's own output has none of
+    // this (see art.ts). Resolved ids only; unresolved ("?") rows have
+    // nothing to look up.
+    const artByStoreId = await getArtForStoreIds(
+      entries
+        .map((entry) => entry.storeId)
+        .filter((id): id is string => Boolean(id))
+    )
+
+    this.library.clear()
+    entries.forEach((entry) => {
+      const appName = entry.storeId ?? `xodus-unresolved-${entry.titleId}`
+      const metadata = entry.storeId
+        ? this.installedGames.get(entry.storeId)
+        : undefined
+      const art = entry.storeId ? artByStoreId.get(entry.storeId) : undefined
+
+      this.library.set(appName, {
+        app_name: appName,
+        runner: 'xodus',
+        art_cover: art?.art_cover ?? '',
+        art_square: art?.art_square ?? '',
+        art_logo: art?.art_logo,
+        art_background: art?.art_background,
+        title: entry.name,
+        canRunOffline: false,
+        installable: Boolean(entry.storeId),
+        is_installed: metadata !== undefined,
+        is_linux_native: false,
+        is_mac_native: false,
+        install: metadata
+          ? {
+              install_path: metadata.path,
+              install_size: '',
+              version: metadata.version,
+              platform: 'Windows',
+              executable: metadata.executable ?? ''
+            }
+          : {}
+      })
+    })
+
+    const arr = Array.from(this.library.values())
+    libraryStore.set('library', arr)
+    logInfo(
+      ['xodus library updated, got', `${arr.length}`, 'titles'],
+      LogPrefix.Xodus
+    )
+
+    return res
+  }
+
+  /**
+   * Loads the FULL current PC Game Pass catalog (every title Game Pass PC
+   * currently offers, not just this account's history - ~500+ titles as of
+   * this writing) from `xodus-cli catalog` as GameInfo objects, decorated
+   * with real art and whatever install state is already known locally.
+   * Unlike `refresh()`/`this.library`, this is not persisted as "the"
+   * library - it backs a separate browse/discover surface (the catalog
+   * screen), since dumping ~500 mostly-never-played titles into the main
+   * Library grid alongside real play history would defeat sorting by
+   * "recently played" etc for every other runner too.
+   *
+   * `catalog` needs no login (confirmed by xodus-cli's own `--help` text
+   * and by a live unauthenticated run), so this can succeed even when
+   * `refresh()` above just failed with "not logged in".
+   */
+  async getCatalog(): Promise<{ games: GameInfo[]; error?: string }> {
+    logInfo('Refreshing xodus catalog...', LogPrefix.Xodus)
+
+    let entries: XodusCatalogEntry[] | undefined = catalogStore.get('entries')
+
+    if (!entries) {
+      const res = await this.runRunnerCommand(['catalog'], {
+        abortId: 'xodus-catalog'
+      })
+
+      if (res.error || !res.stdout.trim()) {
+        const message =
+          res.error ||
+          res.stderr.trim() ||
+          'Unknown error fetching xodus catalog'
+        logWarning(['Failed to fetch xodus catalog:', message], LogPrefix.Xodus)
+        return { games: [], error: message }
+      }
+
+      entries = parseXodusCatalogOutput(res.stdout)
+      catalogStore.set('entries', entries)
+    }
+
+    this.refreshInstalled()
+
+    const artByStoreId = await getArtForStoreIds(
+      entries.map((entry) => entry.storeId)
+    )
+
+    const games: GameInfo[] = entries.map((entry) => {
+      const metadata = this.installedGames.get(entry.storeId)
+      const art = artByStoreId.get(entry.storeId)
+
+      return {
+        app_name: entry.storeId,
+        runner: 'xodus',
+        art_cover: art?.art_cover ?? '',
+        art_square: art?.art_square ?? '',
+        art_logo: art?.art_logo,
+        art_background: art?.art_background,
+        title: entry.name,
+        canRunOffline: false,
+        // Every catalog row has a real store id (unlike `library`'s
+        // occasional unresolved "?" rows), so every one is installable.
+        installable: true,
+        is_installed: metadata !== undefined,
+        is_linux_native: false,
+        is_mac_native: false,
+        install: metadata
+          ? {
+              install_path: metadata.path,
+              install_size: '',
+              version: metadata.version,
+              platform: 'Windows',
+              executable: metadata.executable ?? ''
+            }
+          : {}
+      }
+    })
+
+    logInfo(
+      ['xodus catalog loaded,', `${games.length}`, 'titles'],
+      LogPrefix.Xodus
+    )
+
+    return { games }
+  }
+
+  getGameInfo(appName: string, forceReload = false): GameInfo | undefined {
+    if (!forceReload) {
+      const gameInMemory = this.library.get(appName)
+      if (gameInMemory) return gameInMemory
+    }
+
+    const cached = libraryStore.get('library', [])
+    const fromCache = cached?.find((g) => g.app_name === appName)
+    if (fromCache) return fromCache
+
+    logError(
+      ['Could not find game with id', appName, `in xodus library`],
+      LogPrefix.Xodus
+    )
+    return undefined
+  }
+
+  async getInstallInfo(appName: string): Promise<XodusInstallInfo> {
+    const cache = installStore.get(appName)
+    if (cache) {
+      logDebug('Using cached install info', LogPrefix.Xodus)
+      return cache
+    }
+
+    const game = this.library.get(appName)
+    const metadata = this.getInstallMetadata(appName)
+
+    // xodus-cli has no equivalent of `nile install --info --json` to fetch
+    // a title's size ahead of downloading it - streaming.rs only learns the
+    // real size mid-download (after opening the remote package). Real size
+    // info IS available though, from the same storeedgefd product API used
+    // for cover art (Payload.ApproximateSizeInBytes - the same figure
+    // Microsoft's own Store shows before install) - use that rather than
+    // reporting a hardcoded, misleading 0. It's an approximation from
+    // Microsoft's listing metadata, not a measurement of the real .msixvc
+    // package, so download/disk size are reported as the same figure
+    // (there's no separate compressed-vs-installed breakdown available).
+    const art = (await getArtForStoreIds([appName])).get(appName)
+    const sizeBytes = art?.sizeBytes ?? 0
+
+    const installInfo: XodusInstallInfo = {
+      manifest: {
+        download_size: sizeBytes,
+        disk_size: sizeBytes
+      },
+      game: {
+        id: appName,
+        version: metadata?.version ?? '',
+        path: metadata?.path ?? '',
+        app_name: appName,
+        cloud_saves_supported: false,
+        external_activation: '',
+        is_dlc: false,
+        launch_options: [],
+        owned_dlc: [],
+        platform_versions: { Windows: metadata?.version ?? '' },
+        title: game?.title ?? appName
+      }
+    }
+
+    installStore.set(appName, installInfo)
+    return installInfo
+  }
+
+  async changeGameInstallPath(appName: string, newAppPath: string) {
+    const libraryGameInfo = this.library.get(appName)
+    if (libraryGameInfo) libraryGameInfo.install.install_path = newAppPath
+    else {
+      logWarning(
+        `library game info not found in changeGameInstallPath for ${appName}`,
+        LogPrefix.Xodus
+      )
+    }
+
+    this.refreshInstalled()
+    const metadata = this.installedGames.get(appName)
+    if (metadata) {
+      metadata.path = newAppPath
+      this.writeInstalled()
+    } else {
+      logWarning(
+        `installed game metadata not found in changeGameInstallPath for ${appName}`,
+        LogPrefix.Xodus
+      )
+    }
+  }
+
+  installState(appName: string, state: boolean) {
+    if (!state) {
+      this.installedGames.delete(appName)
+      installStore.delete(appName)
+      return
+    }
+
+    const metadata = this.getInstallMetadata(appName)
+    if (!metadata) {
+      logError(
+        ['Could not find install metadata for', appName],
+        LogPrefix.Xodus
+      )
+      return
+    }
+    this.installedGames.set(appName, metadata)
+  }
+
+  async runRunnerCommand(
+    commandParts: string[],
+    options?: CallRunnerOptions
+  ): Promise<ExecResult> {
+    const { dir, bin } = getXodusBin()
+
+    if (!existsSync(join(dir, bin))) {
+      const error = `xodus-cli binary not found at ${join(
+        dir,
+        bin
+      )} - set "altXodusBin" in Settings > Advanced to point at a real xodus-cli build`
+      logError(error, LogPrefix.Xodus)
+      return { stdout: '', stderr: '', error }
+    }
+
+    return callRunner(
+      commandParts,
+      { name: 'xodus', logPrefix: LogPrefix.Xodus, bin, dir },
+      options ?? {}
+    )
+  }
+
+  getLaunchOptions = () => []
+
+  async listUpdateableGames(): Promise<string[]> {
+    // xodus-cli has no update-check/list-updates subcommand - Game Pass
+    // titles are re-streamed wholesale rather than incrementally patched.
+    // Out of scope for this pass (see task scope notes on version pinning).
+    return []
+  }
+
+  /* eslint-disable-next-line @typescript-eslint/no-unused-vars */
+  changeVersionPinnedStatus(appName: string, status: boolean) {
+    logWarning(
+      'changeVersionPinnedStatus not implemented on Xodus Library Manager'
+    )
+  }
+}
diff --git a/src/backend/storeManagers/xodus/parsing.ts b/src/backend/storeManagers/xodus/parsing.ts
new file mode 100644
index 0000000..96638c2
--- /dev/null
+++ b/src/backend/storeManagers/xodus/parsing.ts
@@ -0,0 +1,200 @@
+import { XMLParser } from 'fast-xml-parser'
+import { existsSync, readFileSync, readdirSync } from 'graceful-fs'
+import { join } from 'path'
+import { logError, logWarning, LogPrefix } from 'backend/logger'
+import { XodusCatalogEntry, XodusLibraryEntry } from 'common/types/xodus'
+
+// Column width of the NAME field in `xodus-cli library`'s output, taken
+// verbatim from the format string in
+// crates/xodus-cli/src/commands/library.rs (`/home/technic/xodus`):
+//
+//   println!("{:<45} {:<25} {:<12} {}", "NAME", "DEVICES", "TITLE ID", "STORE ID")
+//
+// `library` truncates title names to this width before printing (see
+// `truncate()` in that file), so slicing the first 45 characters of each
+// row is a safe way to recover the name even when it contains single
+// spaces (which a naive whitespace-split would break on). Everything after
+// that column - devices/titleId/storeId - is guaranteed to be
+// whitespace-free per field (devices is a `,`-joined list, titleId and
+// storeId are bare tokens), so those three are recovered by splitting the
+// remainder on whitespace, which stays correct even if the DEVICES/TITLE ID
+// columns don't line up exactly (e.g. a long devices list overflowing its
+// 25-char pad).
+const NAME_COLUMN_WIDTH = 45
+
+/**
+ * Parses `xodus-cli library`'s stdout (a fixed-width plain text table -
+ * xodus-cli has no `--json` output mode as of this writing) into structured
+ * rows. See the `library.rs` format string referenced above for ground
+ * truth; this was NOT guessed from sample output.
+ */
+export function parseXodusLibraryOutput(stdout: string): XodusLibraryEntry[] {
+  const entries: XodusLibraryEntry[] = []
+
+  const lines = stdout.split('\n')
+  for (const rawLine of lines) {
+    const line = rawLine.replace(/\r$/, '')
+    if (!line.trim()) continue
+    // Skip the header row ("NAME ... DEVICES ... TITLE ID ... STORE ID")
+    if (line.startsWith('NAME ')) continue
+    if (line.length <= NAME_COLUMN_WIDTH) continue
+
+    const name = line.slice(0, NAME_COLUMN_WIDTH).trimEnd()
+    const remainder = line.slice(NAME_COLUMN_WIDTH).trim()
+    if (!remainder) continue
+
+    const tokens = remainder.split(/\s+/).filter(Boolean)
+
+    let devicesToken = ''
+    let titleId = ''
+    let storeIdToken = ''
+
+    if (tokens.length >= 3) {
+      // devices field was non-empty
+      storeIdToken = tokens[tokens.length - 1]
+      titleId = tokens[tokens.length - 2]
+      devicesToken = tokens.slice(0, tokens.length - 2).join('')
+    } else if (tokens.length === 2) {
+      // devices field was blank (game has no recorded devices)
+      ;[titleId, storeIdToken] = tokens
+    } else {
+      // Malformed row we can't confidently parse - skip rather than guess
+      continue
+    }
+
+    entries.push({
+      name,
+      devices: devicesToken ? devicesToken.split(',').filter(Boolean) : [],
+      titleId,
+      storeId: storeIdToken && storeIdToken !== '?' ? storeIdToken : undefined
+    })
+  }
+
+  return entries
+}
+
+// Column width of the NAME field in `xodus-cli catalog`'s output, taken
+// verbatim from the format string in
+// crates/xodus-cli/src/commands/catalog.rs (`/home/technic/xodus`):
+//
+//   println!("{:<50} {}", "NAME", "STORE ID")
+//
+// Different width and shape than `library`'s output (no DEVICES/TITLE ID
+// columns here) - `catalog` truncates names to 50 chars itself (see
+// `truncate()` in that file) and always prints a resolvable store id
+// (it comes straight from the SIGL id list), so only the NAME can ever come
+// back as "?" (when title-name resolution failed for that batch).
+const CATALOG_NAME_COLUMN_WIDTH = 50
+
+/**
+ * Parses `xodus-cli catalog`'s stdout (a fixed-width plain text table, same
+ * "no --json mode" situation as `library` - see that command's comment
+ * above) into structured rows. Verified against a real `catalog` run
+ * against this machine's build (>500 real current PC Game Pass titles).
+ */
+export function parseXodusCatalogOutput(stdout: string): XodusCatalogEntry[] {
+  const entries: XodusCatalogEntry[] = []
+
+  const lines = stdout.split('\n')
+  for (const rawLine of lines) {
+    const line = rawLine.replace(/\r$/, '')
+    if (!line.trim()) continue
+    // Skip the header row ("NAME ... STORE ID")
+    if (line.startsWith('NAME ')) continue
+    if (line.length <= CATALOG_NAME_COLUMN_WIDTH) continue
+
+    const rawName = line.slice(0, CATALOG_NAME_COLUMN_WIDTH).trimEnd()
+    const storeId = line.slice(CATALOG_NAME_COLUMN_WIDTH).trim()
+    if (!storeId) continue
+
+    // Fall back to the store id as a display name on the rare "?" rows
+    // rather than showing a literal "?" in the catalog UI.
+    entries.push({ name: rawName === '?' ? storeId : rawName, storeId })
+  }
+
+  return entries
+}
+
+const xmlParser = new XMLParser({
+  ignoreAttributes: false,
+  attributeNamePrefix: ''
+})
+
+/**
+ * Reads `<installDir>/MicrosoftGame.config` and returns the executable names
+ * listed in its `<ExecutableList>`. Per Microsoft's public GDK project
+ * schema (https://learn.microsoft.com/gaming/gdk/_content/gc/reference/tools/misc/mgcschema),
+ * the relevant shape is:
+ *
+ *   <Game>
+ *     <ExecutableList>
+ *       <Executable Name="Game.exe" Id="Game" .../>
+ *     </ExecutableList>
+ *   </Game>
+ *
+ * Used to resolve the right `--exe` to pass to `xodus-cli run`: xodus-cli's
+ * own default-exe-picking in `run` isn't reliable for titles with multiple
+ * executables (a known, real xodus-cli limitation - not ours to silently
+ * paper over, but worth working around on the caller side).
+ *
+ * The filename's casing is NOT consistent across real extracted titles -
+ * checked 5 real installs on this machine and got a 3/2 split between
+ * "MicrosoftGame.Config" and "MicrosoftGame.config". Since Linux
+ * filesystems are case-sensitive, a naive `join(installDir,
+ * 'MicrosoftGame.config')` lookup silently misses roughly half of them, so
+ * this does a case-insensitive directory scan instead.
+ */
+export function getExecutablesFromMicrosoftGameConfig(
+  installDir: string
+): string[] {
+  let configPath: string | undefined
+  try {
+    const entry = readdirSync(installDir).find(
+      (file) => file.toLowerCase() === 'microsoftgame.config'
+    )
+    if (entry) configPath = join(installDir, entry)
+  } catch (error) {
+    logWarning(
+      ['Could not read install directory', installDir, error],
+      LogPrefix.Xodus
+    )
+    return []
+  }
+
+  if (!configPath || !existsSync(configPath)) {
+    logWarning(
+      ['MicrosoftGame.config not found in', installDir],
+      LogPrefix.Xodus
+    )
+    return []
+  }
+
+  try {
+    const xml = readFileSync(configPath, 'utf-8')
+    const parsed = xmlParser.parse(xml)
+    const execList = parsed?.Game?.ExecutableList?.Executable
+    if (!execList) return []
+
+    // fast-xml-parser returns a single object (not an array) when there's
+    // only one matching element
+    const executables = Array.isArray(execList) ? execList : [execList]
+    const names = executables
+      .map((exe) => exe?.Name)
+      .filter((name): name is string => typeof name === 'string' && !!name)
+
+    // Prioritize main game binaries over launcher wrappers (e.g. Fallout4.exe over Fallout4Launcher.exe)
+    return names.sort((a, b) => {
+      const aIsLauncher = a.toLowerCase().includes('launcher')
+      const bIsLauncher = b.toLowerCase().includes('launcher')
+      if (aIsLauncher && !bIsLauncher) return 1
+      if (!aIsLauncher && bIsLauncher) return -1
+      return 0
+    })
+  } catch (error) {
+    logError(
+      ['Failed to parse MicrosoftGame.config at', configPath, error],
+      LogPrefix.Xodus
+    )
+    return []
+  }
+}
diff --git a/src/backend/storeManagers/xodus/user.ts b/src/backend/storeManagers/xodus/user.ts
new file mode 100644
index 0000000..7f398a5
--- /dev/null
+++ b/src/backend/storeManagers/xodus/user.ts
@@ -0,0 +1,48 @@
+import { LogPrefix, logError, logInfo } from 'backend/logger'
+import { libraryManagerMap } from '..'
+import { configStore } from './electronStores'
+
+/**
+ * Unlike nile/legendary/gog, xodus-cli's `login` is not something Heroic
+ * drives through an in-app OAuth webview - it opens its own native
+ * GTK/WebKit window (a CloudExperienceHost-style MSA flow) and stores the
+ * resulting token straight into the system keyring itself. Heroic's role
+ * here is just: launch `xodus-cli login`, wait for it to exit, and infer
+ * success/failure from that - there's no login data to hand back to a
+ * webview, and no account/profile info xodus-cli exposes to show a
+ * username with.
+ */
+export class XodusUser {
+  static async login(): Promise<{ status: 'done' | 'failed' }> {
+    logInfo('Launching xodus-cli login...', LogPrefix.Xodus)
+    const res = await libraryManagerMap['xodus'].runRunnerCommand(['login'], {
+      abortId: 'xodus-login'
+    })
+
+    if (res.abort || res.error) {
+      logError(
+        ['xodus-cli login failed:', res.error ?? 'aborted'],
+        LogPrefix.Xodus
+      )
+      configStore.set('loggedIn', false)
+      return { status: 'failed' }
+    }
+
+    configStore.set('loggedIn', true)
+    return { status: 'done' }
+  }
+
+  static async logout() {
+    const res = await libraryManagerMap['xodus'].runRunnerCommand(['logout'], {
+      abortId: 'xodus-logout'
+    })
+    if (res.error) {
+      logError(['xodus-cli logout failed:', res.error], LogPrefix.Xodus)
+    }
+    configStore.set('loggedIn', false)
+  }
+
+  static isLoggedIn(): boolean {
+    return configStore.get_nodefault('loggedIn') ?? false
+  }
+}
