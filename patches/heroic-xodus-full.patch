+import { useTranslation } from 'react-i18next'
+import useSetting from 'frontend/hooks/useSetting'
+import { PathSelectionBox } from 'frontend/components/UI'
+
+// Xbox Game Pass titles run through xodus's own custom-built Wine fork (a
+// from-scratch GDK/XGameRuntime reimplementation), not a stock Wine/Proton
+// build - Heroic can't auto-manage or download this like it does for other
+// runners' Wine versions, so it just needs to be pointed at an
+// already-built binary. `xodus-cli run` is handed this path directly and
+// does the entire Wine launch itself (see storeManagers/xodus/games.ts).
+const XodusWineBin = () => {
+  const { t } = useTranslation()
+  const [xodusWineBin, setXodusWineBin] = useSetting('xodusWineBin', '')
+
+  return (
+    <PathSelectionBox
+      htmlId="setting-xodus-wine-bin"
+      label={t(
+        'setting.xodus-wine-bin',
+        "Choose xodus's custom Wine binary to use for Xbox Game Pass (needs restart)"
+      )}
+      type="file"
+      onPathChange={setXodusWineBin}
+      path={xodusWineBin}
+      placeholder={t(
+        'placeholder.xodus-wine-bin',
+        'No xodus Wine binary configured - Xbox Game Pass titles will not launch'
+      )}
+      pathDialogTitle={t(
+        'box.choose-xodus-wine-binary',
+        'Select xodus Wine Binary (needs restart)'
+      )}
+    />
+  )
+}
+
+export default XodusWineBin
