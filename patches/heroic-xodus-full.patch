@@ -0,0 +1,52 @@
+import { parseXodusCatalogOutput } from '../parsing'
+
+describe('parseXodusCatalogOutput', () => {
+  test('parses a real captured `xodus-cli catalog` sample verbatim', () => {
+    // Byte-for-byte captured from a real, live `xodus-cli catalog` run on
+    // this machine (/home/technic/xodus/target/release/xodus-cli) - not
+    // hand-typed/guessed padding. See the format string in
+    // crates/xodus-cli/src/commands/catalog.rs referenced in parsing.ts.
+    const realSample =
+      'NAME                                               STORE ID\n' +
+      '1000xRESIST                                        9NPDN9R45JX4\n' +
+      '33 Immortals                                       9P8LR42PTRGJ\n' +
+      '9 Kings (Game Preview)                             9NNM7PKZN3JF\n'
+
+    expect(parseXodusCatalogOutput(realSample)).toEqual([
+      { name: '1000xRESIST', storeId: '9NPDN9R45JX4' },
+      { name: '33 Immortals', storeId: '9P8LR42PTRGJ' },
+      { name: '9 Kings (Game Preview)', storeId: '9NNM7PKZN3JF' }
+    ])
+  })
+
+  test('falls back to the store id as the display name for unresolved ("?") rows', () => {
+    // catalog.rs: `let name = titles.get(id).map(...).unwrap_or("?")` - a
+    // real (if rare) case when a batch title-name resolution call fails.
+    const name = '?'.padEnd(50)
+    const sample = `NAME                                               STORE ID\n${name} 9ABCDEFGHIJK\n`
+
+    expect(parseXodusCatalogOutput(sample)).toEqual([
+      { name: '9ABCDEFGHIJK', storeId: '9ABCDEFGHIJK' }
+    ])
+  })
+
+  test('skips the header row, blank lines, and rows with no store id', () => {
+    const sample =
+      'NAME                                               STORE ID\n' +
+      '\n' +
+      `${'Some title with no store id'.padEnd(50)}\n`
+
+    expect(parseXodusCatalogOutput(sample)).toEqual([])
+  })
+
+  test('handles a name at exactly the 50-char truncation boundary', () => {
+    // catalog.rs truncates names to 50 chars itself (see `truncate()`),
+    // so a real row's name field is never longer than this.
+    const longName = 'A'.repeat(50)
+    const sample = `NAME                                               STORE ID\n${longName} 9XXXXXXXXXXX\n`
+
+    expect(parseXodusCatalogOutput(sample)).toEqual([
+      { name: longName, storeId: '9XXXXXXXXXXX' }
+    ])
+  })
+})
diff --git a/src/backend/storeManagers/xodus/art.ts b/src/backend/storeManagers/xodus/art.ts
new file mode 100644
index 0000000..b90cb2b
--- /dev/null
+++ b/src/backend/storeManagers/xodus/art.ts
@@ -0,0 +1,154 @@
+import { axiosClient } from 'backend/utils'
+import { LogPrefix, logWarning } from 'backend/logger'
+import CacheStore from 'backend/cache'
+import { XodusArtUrls } from 'common/types/xodus'
+
+/**
+ * `xodus-cli library`/`catalog` don't return any art at all (they're just
+ * plain title/store-id tables - see parsing.ts). Real box art/logo/hero
+ * images DO exist though, from Microsoft's public, unauthenticated store
+ * product API - confirmed live against real entitled titles on this
+ * account (Forza Horizon 6 = 9NR1R1XWLCNB, Cyberpunk 2077 = BX3M8L83BBRW):
+ *
+ *   curl "https://storeedgefd.dsx.mp.microsoft.com/v9.0/products/{storeId}?market=US&locale=en-us&deviceFamily=Windows.Desktop"
+ *
+ * The real response shape (inspected directly, not guessed) is
+ * `Payload.Images: ImageItem[]`, each with an `ImageType` field (NOT
+ * "ImagePurpose") and a plain `Url` (no query string needed - verified with
+ * a raw HEAD request that it serves `image/jpeg` as-is). Real `ImageType`
+ * values seen across both titles: "Poster" (portrait, ~1440x2160),
+ * "BoxArt" (square, e.g. 2160x2160), "hero" (wide banner, e.g. 3840x2160)
+ * and "logo" (transparent title logo - not present on every title).
+ */
+const STORE_API_BASE = 'https://storeedgefd.dsx.mp.microsoft.com/v9.0/products'
+
+// Box art essentially never changes for a given product id, so cache
+// aggressively (a week) - this also means the ~500-title full catalog only
+// pays its real per-title network cost once every 7 days, not on every
+// catalog screen open.
+const ART_CACHE_TTL_MINUTES = 60 * 24 * 7
+
+const artCache = new CacheStore<XodusArtUrls>(
+  'xodus_art',
+  ART_CACHE_TTL_MINUTES
+)
+
+// How many concurrent in-flight requests to storeedgefd at once. This is a
+// public, unauthenticated endpoint (confirmed no auth needed), but nothing
+// stops it from rate-limiting a burst of ~500 sequential single-title
+// requests - a small worker pool keeps a full catalog art-populate
+// reasonably fast without hammering it with 500 simultaneous connections.
+const CONCURRENCY = 8
+
+interface StoreEdgeImage {
+  ImageType?: string
+  Url?: string
+}
+
+interface StoreEdgeProductResponse {
+  Payload?: {
+    Images?: StoreEdgeImage[]
+    // Real, confirmed-live field: the install-size figure Microsoft's own
+    // Store shows before installing a title (see the XodusArtUrls.sizeBytes
+    // doc comment in common/types/xodus.ts for why this is bundled here).
+    ApproximateSizeInBytes?: number
+  }
+}
+
+async function fetchArtForStoreId(
+  storeId: string,
+  market: string,
+  locale: string
+): Promise<XodusArtUrls | undefined> {
+  const { data } = await axiosClient.get<StoreEdgeProductResponse>(
+    `${STORE_API_BASE}/${storeId}`,
+    { params: { market, locale, deviceFamily: 'Windows.Desktop' } }
+  )
+
+  const images = data?.Payload?.Images
+  if (!Array.isArray(images) || !images.length) return undefined
+
+  const urlForType = (type: string) =>
+    images.find((img) => img?.ImageType === type)?.Url || undefined
+
+  const sizeBytes = data?.Payload?.ApproximateSizeInBytes
+  const urls: XodusArtUrls = {
+    art_square: urlForType('BoxArt'),
+    art_cover: urlForType('Poster') ?? urlForType('BoxArt'),
+    art_logo: urlForType('logo'),
+    art_background: urlForType('hero'),
+    sizeBytes:
+      typeof sizeBytes === 'number' && sizeBytes > 0 ? sizeBytes : undefined
+  }
+
+  // If nothing at all resolved, treat this as a failure rather than
+  // caching an all-empty result for a week.
+  if (
+    !urls.art_square &&
+    !urls.art_cover &&
+    !urls.art_logo &&
+    !urls.art_background &&
+    !urls.sizeBytes
+  ) {
+    return undefined
+  }
+
+  return urls
+}
+
+/**
+ * Resolves real cover/logo/background art for a batch of store ids,
+ * checking `artCache` first and only hitting the network for misses. Never
+ * throws - a single title's fetch failing (network error, unresolvable id,
+ * rate limit, whatever) is logged and simply omitted from the result map
+ * rather than aborting the whole batch, since a `library`/`catalog` refresh
+ * covering dozens to hundreds of titles shouldn't fail entirely because one
+ * of them couldn't be resolved.
+ */
+export async function getArtForStoreIds(
+  storeIds: string[],
+  market = 'US',
+  locale = 'en-us'
+): Promise<Map<string, XodusArtUrls>> {
+  const result = new Map<string, XodusArtUrls>()
+  const uniqueIds = Array.from(new Set(storeIds.filter(Boolean)))
+  const toFetch: string[] = []
+
+  for (const id of uniqueIds) {
+    const cached = artCache.get(id)
+    if (cached) {
+      result.set(id, cached)
+    } else {
+      toFetch.push(id)
+    }
+  }
+
+  if (!toFetch.length) return result
+
+  let cursor = 0
+  const worker = async () => {
+    for (;;) {
+      const index = cursor++
+      if (index >= toFetch.length) return
+      const storeId = toFetch[index]
+      try {
+        const urls = await fetchArtForStoreId(storeId, market, locale)
+        if (urls) {
+          artCache.set(storeId, urls)
+          result.set(storeId, urls)
+        }
+      } catch (error) {
+        logWarning(
+          ['Failed to fetch cover art for', storeId, error],
+          LogPrefix.Xodus
+        )
+      }
+    }
+  }
+
+  await Promise.all(
+    Array.from({ length: Math.min(CONCURRENCY, toFetch.length) }, worker)
+  )
+
+  return result
+}
