+import * as logger from 'backend/logger'
+import XodusGame from '../games'
+
+jest.mock('electron')
+
+// `getGameInfo()`'s "unknown app" fallback path (both in games.ts and
+// library.ts) logs via `logError`. The real implementation needs
+// `backend/logger`'s `init()` to have run first (a real, separate gap this
+// test doesn't need to exercise), so it's stubbed out entirely rather than
+// calling init() - this test only cares about `repair()`'s return value,
+// not what it logs along the way.
+jest.spyOn(logger, 'logError').mockImplementation(() => undefined)
+
+describe('XodusGame.repair', () => {
+  test('propagates a real error rather than fabricating success when no install path is known', async () => {
+    // No install has ever been registered for this id, so
+    // XodusLibraryManager.getGameInfo() falls back to its "unknown game"
+    // default (empty `install`) - repair() must refuse rather than call
+    // `streaming` against an empty/undefined path.
+    const game = new XodusGame('xodus-test-nonexistent-app')
+    const result = await game.repair()
+
+    expect(result.error).toBeDefined()
+    expect(result.error).toContain('no known install path')
+  })
+})
diff --git a/src/backend/storeManagers/xodus/__tests__/library.test.ts b/src/backend/storeManagers/xodus/__tests__/library.test.ts
new file mode 100644
index 0000000..b2d4057
--- /dev/null
+++ b/src/backend/storeManagers/xodus/__tests__/library.test.ts
@@ -0,0 +1,115 @@
+/**
+ * Smoke test exercising XodusLibraryManager against the REAL xodus-cli
+ * binary (not mocked) at /home/technic/xodus/target/release/xodus-cli.
+ *
+ * This sandbox has no reachable D-Bus Secret Service / login session, so
+ * authenticated commands (`library`) can't be exercised end-to-end here -
+ * that part is proven structurally (real process spawn, real stdout/error
+ * plumbing) via the unauthenticated `catalog` command instead, and the
+ * expected graceful "not logged in" failure path for `library` is asserted
+ * directly. If this file is run on a machine with a real xodus-cli login
+ * session, `refresh()` will additionally populate real library entries.
+ */
+import { mkdirSync, writeFileSync, chmodSync, rmSync } from 'fs'
+import { dirname, join } from 'path'
+import { configPath, publicDir } from 'backend/constants/paths'
+import { GlobalConfig } from 'backend/config'
+import { init as initLogger } from 'backend/logger'
+import XodusLibraryManager from '../library'
+import { getExecutablesFromMicrosoftGameConfig } from '../parsing'
+
+jest.mock('electron')
+
+// Deliberately NOT mocking backend/logger here: `callRunner` (real,
+// unmocked - we want the real spawn behavior) needs a real, initialized
+// LogWriter to log through. `backend/logger`'s module-level
+// `heroicLogWriter`/per-runner writers are lazily created by `init()` (the
+// same function Heroic's real app entrypoint calls at startup) - without
+// calling it here first, any log call crashes on an uninitialized writer.
+//
+// `init()`'s own startup log line embeds system info, which on real
+// Electron reads `process.getSystemVersion()` (an Electron main-process
+// extension of the global `process` object that plain Node/jest doesn't
+// have). No test in this repo has exercised a real `init()` before this
+// one, so this gap was never hit previously - stub it minimally here.
+;(process as unknown as { getSystemVersion: () => string }).getSystemVersion =
+  () => '0.0.0'
+
+const REAL_XODUS_CLI = '/home/technic/xodus/target/release/xodus-cli'
+
+// init()'s startup log line also gathers "software versions" for
+// legendary/gogdl/nile/comet, which in this dev checkout aren't built
+// (nothing under public/bin/ here) - a real, pre-existing bug (found via
+// this test, unrelated to xodus) is that when their `spawn()` calls ENOENT,
+// backend/utils.ts's `errorHandler` receives a non-string Error and crashes
+// on `error.includes(...)`, which is not something this test should have to
+// route around by fixing shared error-handling code. Simplest, most
+// self-contained workaround: give it harmless real executables to find
+// instead of touching that shared code path.
+const stubBinDir = join(publicDir, 'bin', process.arch, process.platform)
+const stubBinaries = ['legendary', 'gogdl', 'nile', 'comet']
+
+describe('XodusLibraryManager (live xodus-cli integration)', () => {
+  let manager: XodusLibraryManager
+
+  beforeAll(() => {
+    // GlobalConfig writes its config.json under the (mocked) app folder -
+    // create it first, same as Heroic's real createNecessaryFolders() does
+    // at startup.
+    mkdirSync(dirname(configPath), { recursive: true })
+    mkdirSync(stubBinDir, { recursive: true })
+    for (const bin of stubBinaries) {
+      const path = join(stubBinDir, bin)
+      writeFileSync(path, '#!/bin/sh\necho "0.0.0-stub"\nexit 0\n')
+      chmodSync(path, 0o755)
+    }
+    GlobalConfig.get().setSetting('altXodusBin', REAL_XODUS_CLI)
+    initLogger()
+    manager = new XodusLibraryManager()
+  })
+
+  afterAll(() => {
+    rmSync(stubBinDir, { recursive: true, force: true })
+  })
+
+  test('runRunnerCommand spawns the real xodus-cli binary and returns real output (catalog, no auth needed)', async () => {
+    const res = await manager.runRunnerCommand(['catalog', '--market', 'US'], {
+      abortId: 'test-catalog'
+    })
+
+    expect(res.error).toBeUndefined()
+    // Real header line xodus-cli prints, from catalog.rs:
+    //   println!("{:<50} {}", "NAME", "STORE ID")
+    expect(res.stdout).toContain('NAME')
+    expect(res.stdout).toContain('STORE ID')
+    // A real, currently-listed Game Pass title/store id pair (confirmed
+    // present in a live `catalog` run during this session).
+    expect(res.stdout).toContain('9NBLGGH43KZB') // ASTRONEER
+  }, 120000)
+
+  test('refresh() against a real (unauthenticated) session fails gracefully rather than throwing', async () => {
+    const res = await manager.refresh()
+    expect(res).not.toBeNull()
+    // Real xodus-cli error message from library.rs when no user token exists:
+    //   eprintln!("Not logged in - run `xodus-cli login` first");
+    expect(res?.error).toContain('Not logged in')
+  }, 30000)
+
+  test('getExecutablesFromMicrosoftGameConfig resolves real extracted titles on this machine', () => {
+    // These are real xodus-cli extraction outputs from manual testing done
+    // on this machine (see /home/technic/xodus-gamepass-compat.md) - used
+    // here as ground truth for the parser, not synthetic data. Casing is
+    // intentionally inconsistent between them (a real, verified finding).
+    expect(
+      getExecutablesFromMicrosoftGameConfig('/home/technic/xodus-live-test')
+    ).toEqual(['love.exe'])
+    expect(
+      getExecutablesFromMicrosoftGameConfig('/home/technic/xodus-test-Grounded')
+    ).toEqual(['Maine\\Binaries\\WinGDK\\Maine-WinGDK-Shipping.exe'])
+    expect(
+      getExecutablesFromMicrosoftGameConfig(
+        '/home/technic/xodus-test-VampireSurvivors'
+      )
+    ).toEqual(['VampireSurvivors.exe'])
+  })
+})
