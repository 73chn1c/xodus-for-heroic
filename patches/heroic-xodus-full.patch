+++ b/scripts/install-xodus-heroic.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# XODUS for Heroic Installer & Configuration Script
+# Sets up xodus-cli binaries, Heroic configuration, and Proton GDK runner.
+
+echo "========================================="
+echo " XODUS for Heroic Games Launcher Installer"
+echo "========================================="
+
+BIN_DIR="${HOME}/.local/bin"
+HEROIC_CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/heroic"
+mkdir -p "${BIN_DIR}"
+mkdir -p "${HEROIC_CONFIG_DIR}"
+
+# 1. Verify xodus-cli
+if command -v xodus-cli &>/dev/null; then
+    echo "[✓] xodus-cli found at: $(command -v xodus-cli)"
+elif [ -f "${BIN_DIR}/xodus-cli" ]; then
+    echo "[✓] xodus-cli found at: ${BIN_DIR}/xodus-cli"
+else
+    echo "[!] xodus-cli not found in PATH or ~/.local/bin."
+    echo "    Please install or copy xodus-cli to ${BIN_DIR}/xodus-cli"
+fi
+
+# 2. Heroic runner paths
+RUNNERS_DIR="${HOME}/.config/heroic/tools/proton"
+mkdir -p "${RUNNERS_DIR}"
+
+echo "[✓] Setup completed successfully."
+echo "    Run 'xodus-cli login' to authenticate with Xbox Live."
+echo "    Launch Heroic to access your Game Pass library."
