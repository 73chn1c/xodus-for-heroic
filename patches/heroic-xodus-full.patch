@@ -0,0 +1,63 @@
+import { useEffect, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import useSetting from 'frontend/hooks/useSetting'
+import { PathSelectionBox } from 'frontend/components/UI'
+
+// xodus-cli (the companion Rust CLI that handles Xbox Game Pass
+// auth/catalog/download/launch) is not bundled with Heroic like
+// legendary/gogdl/nile are - there's no default fallback build, so this
+// must be set for the xodus store to do anything at all.
+const AltXodusBin = () => {
+  const { t } = useTranslation()
+  const [xodusVersion, setXodusVersion] = useState('')
+  const [altXodusBin, setAltXodusBin] = useSetting('altXodusBin', '')
+
+  useEffect(() => {
+    const getMoreInfo = async () => {
+      if (!altXodusBin) {
+        setXodusVersion('')
+        return
+      }
+      const xodusVer = await window.api.getXodusVersion()
+      if (xodusVer === 'invalid') {
+        setXodusVersion('Invalid')
+        setTimeout(() => {
+          setAltXodusBin('')
+          return setXodusVersion('')
+        }, 3000)
+        return
+      }
+      return setXodusVersion(xodusVer)
+    }
+    getMoreInfo()
+  }, [altXodusBin])
+
+  return (
+    <PathSelectionBox
+      htmlId="setting-alt-xodus"
+      label={t(
+        'setting.alt-xodus-bin',
+        'Choose the xodus-cli Binary to use for Xbox Game Pass (needs restart)'
+      )}
+      type="file"
+      onPathChange={setAltXodusBin}
+      path={altXodusBin}
+      placeholder={t(
+        'placeholder.alt-xodus-bin',
+        'No xodus-cli binary configured - Xbox Game Pass will not work'
+      )}
+      pathDialogTitle={t(
+        'box.choose-xodus-binary',
+        'Select xodus-cli Binary (needs restart)'
+      )}
+      afterInput={
+        <span className="smallMessage">
+          {t('other.xodus-version', 'xodus-cli Version: ')}
+          {xodusVersion}
+        </span>
+      }
+    />
+  )
+}
+
+export default AltXodusBin
