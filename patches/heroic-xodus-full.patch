+.xodusCatalog {
+  display: flex;
+  flex-direction: column;
+  min-height: 90vh;
+}
+
+.xodusCatalogHeader {
+  padding: var(--space-md-fixed);
+  margin: 0;
+}
+
+.xodusCatalogHeaderWrapper {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: var(--space-sm);
+}
+
+.xodusCatalogTitle {
+  display: flex;
+  align-items: center;
+  gap: var(--space-sm);
+  font-size: var(--text-md);
+  color: var(--text-default);
+}
+
+.xodusCatalogActions {
+  display: flex;
+  align-items: center;
+  gap: var(--space-sm);
+}
+
+.xodusCatalogIconButton {
+  background: transparent;
+  border: 1px solid var(--divider, rgba(255, 255, 255, 0.12));
+  border-radius: var(--space-2xs);
+  color: var(--text-default);
+  cursor: pointer;
+  padding: var(--space-2xs) var(--space-xs);
+}
+
+.xodusCatalogIconButton:disabled {
+  cursor: default;
+  opacity: 0.5;
+}
+
+.xodusCatalogLoginBanner {
+  margin: 0 var(--space-md-fixed) var(--space-md);
+  padding: var(--space-sm) var(--space-md);
+  border-radius: var(--space-2xs);
+  background: var(--background-secondary, rgba(255, 255, 255, 0.06));
+  color: var(--text-default);
+}
+
+.xodusCatalogError {
+  margin: var(--space-md) var(--space-md-fixed);
+  color: var(--danger, #e74c3c);
+}
+
+.xodusCatalogEmpty {
+  margin: var(--space-md) var(--space-md-fixed);
+  color: var(--text-secondary);
+}
+
+/*
+ * Same grid layout as the main Library screen's `.gameList`
+ * (screens/Library/index.css) - kept as a local copy rather than importing
+ * that stylesheet directly so this screen renders correctly even when
+ * reached without the Library route chunk having loaded first (e.g. a
+ * direct deep link/reload on /xodus-catalog).
+ */
+.xodusCatalog .gameList {
+  color: var(--text-secondary);
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(156px, 1fr));
+  grid-gap: 1.5rem;
+  padding: 0 var(--space-md-fixed) var(--space-3xl);
+  margin: var(--space-md) 0;
