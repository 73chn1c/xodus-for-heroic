diff --git a/src/backend/storeManagers/xodus/__tests__/art.test.ts b/src/backend/storeManagers/xodus/__tests__/art.test.ts
new file mode 100644
index 0000000..340ef20
--- /dev/null
+++ b/src/backend/storeManagers/xodus/__tests__/art.test.ts
@@ -0,0 +1,100 @@
+/**
+ * Live integration test against Microsoft's real, unauthenticated
+ * storeedgefd product API - not mocked, same "prove it against the real
+ * thing" approach as library.test.ts's live `xodus-cli catalog` test.
+ * Requires real network access.
+ */
+import { mkdirSync, writeFileSync, chmodSync, rmSync } from 'fs'
+import { dirname, join } from 'path'
+import { configPath, publicDir } from 'backend/constants/paths'
+import { init as initLogger } from 'backend/logger'
+import { getArtForStoreIds } from '../art'
+
+jest.mock('electron')
+
+// See library.test.ts for why this stub is needed: `init()`'s startup log
+// line reads `process.getSystemVersion()`, an Electron main-process
+// extension of `process` that plain Node/jest doesn't have, and
+// `backend/logger`'s writers are only usable after `init()` runs (a real
+// `logWarning()` call - which art.ts's per-title failure path makes - would
+// otherwise crash on an uninitialized writer).
+;(process as unknown as { getSystemVersion: () => string }).getSystemVersion =
+  () => '0.0.0'
+
+// `init()`'s startup log line also gathers "software versions" for
+// legendary/gogdl/nile/comet by spawning them - not built in this dev
+// checkout (nothing under public/bin/ here), and a real, pre-existing bug
+// (also hit and documented in library.test.ts) is that their ENOENT crashes
+// backend/utils.ts's `errorHandler` on a non-string Error. Same
+// self-contained workaround: give it harmless real executables to find.
+const stubBinDir = join(publicDir, 'bin', process.arch, process.platform)
+const stubBinaries = ['legendary', 'gogdl', 'nile', 'comet']
+
+beforeAll(() => {
+  mkdirSync(dirname(configPath), { recursive: true })
+  mkdirSync(stubBinDir, { recursive: true })
+  for (const bin of stubBinaries) {
+    const path = join(stubBinDir, bin)
+    writeFileSync(path, '#!/bin/sh\necho "0.0.0-stub"\nexit 0\n')
+    chmodSync(path, 0o755)
+  }
+  initLogger()
+})
+
+afterAll(() => {
+  rmSync(stubBinDir, { recursive: true, force: true })
+})
+
+// Real, currently-entitled titles on the account this integration was
+// built against (confirmed live via curl during this session) - used as
+// ground truth store ids, not guessed.
+const FORZA_HORIZON_6 = '9NR1R1XWLCNB'
+const CYBERPUNK_2077 = 'BX3M8L83BBRW'
+// Deliberately not a real Microsoft Store product id, to exercise the
+// per-title failure path without affecting the real ids' results.
+const INVALID_STORE_ID = '0000000000INVALID'
+
+describe('getArtForStoreIds (live storeedgefd integration)', () => {
+  test('resolves real BoxArt/Poster/hero art for real store ids', async () => {
+    const result = await getArtForStoreIds([FORZA_HORIZON_6, CYBERPUNK_2077])
+
+    const forza = result.get(FORZA_HORIZON_6)
+    expect(forza).toBeDefined()
+    expect(forza?.art_square).toMatch(
+      /^https:\/\/store-images\.s-microsoft\.com/
+    )
+    expect(forza?.art_cover).toMatch(
+      /^https:\/\/store-images\.s-microsoft\.com/
+    )
+    expect(forza?.art_background).toMatch(
+      /^https:\/\/store-images\.s-microsoft\.com/
+    )
+
+    // Cyberpunk 2077's real product listing has a logo image, unlike Forza
+    // Horizon 6's (confirmed live during this session) - exercises that
+    // `art_logo` really is read from the response rather than hardcoded.
+    const cyberpunk = result.get(CYBERPUNK_2077)
+    expect(cyberpunk?.art_logo).toMatch(
+      /^https:\/\/store-images\.s-microsoft\.com/
+    )
+
+    // Real install-size figure from the same response
+    // (Payload.ApproximateSizeInBytes) - used to replace the previously
+    // hardcoded `download_size: 0, disk_size: 0` in getInstallInfo(). A
+    // real, large PC game's listing should report a plausible size (tens
+    // to hundreds of GB), not 0 and not something absurd.
+    expect(forza?.sizeBytes).toBeGreaterThan(1_000_000_000)
+    expect(forza?.sizeBytes).toBeLessThan(1_000_000_000_000)
+  }, 30000)
+
+  test('omits (rather than throws for) a store id storeedgefd cannot resolve', async () => {
+    const result = await getArtForStoreIds([INVALID_STORE_ID])
+    expect(result.has(INVALID_STORE_ID)).toBe(false)
+  }, 30000)
+
+  test('a batch with one bad id still resolves the good ones', async () => {
+    const result = await getArtForStoreIds([INVALID_STORE_ID, FORZA_HORIZON_6])
+    expect(result.has(INVALID_STORE_ID)).toBe(false)
+    expect(result.get(FORZA_HORIZON_6)?.art_square).toBeTruthy()
+  }, 30000)
+})
