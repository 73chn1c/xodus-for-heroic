diff --git a/src/frontend/screens/XodusCatalog/index.tsx b/src/frontend/screens/XodusCatalog/index.tsx
new file mode 100644
index 0000000..b74ab9c
--- /dev/null
+++ b/src/frontend/screens/XodusCatalog/index.tsx
@@ -0,0 +1,163 @@
+import './index.css'
+
+import { useCallback, useContext, useEffect, useMemo, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Link } from 'react-router-dom'
+import { FontAwesomeIcon } from '@fortawesome/react-fontawesome'
+import {
+  faArrowDownAZ,
+  faArrowDownZA,
+  faSyncAlt
+} from '@fortawesome/free-solid-svg-icons'
+
+import { GameInfo, Runner } from 'common/types'
+import ContextProvider from 'frontend/state/ContextProvider'
+import { UpdateComponent } from 'frontend/components/UI'
+import SearchBar from 'frontend/components/UI/SearchBar'
+import GamesList from 'frontend/screens/Library/components/GamesList'
+import { openInstallGameModal } from 'frontend/state/InstallGameModal'
+
+/**
+ * Native browse/discover screen for the FULL current PC Game Pass catalog
+ * (backed by `xodus-cli catalog` - see backend/storeManagers/xodus/library.ts
+ * `getCatalog()`), as opposed to `xodus.library` (the account's played
+ * history, shown in the main Library grid). There is no website equivalent
+ * to embed the way the other runners' "Stores" sidebar entries do (those
+ * are webviews pointing at real store websites with their own purchase
+ * flows) - Game Pass has no purchase step, so this is a real native list
+ * with a working Install action per title instead, reusing the exact same
+ * `GamesList`/`GameCard` components (and therefore the exact same
+ * install/play/uninstall/repair flow) the main Library screen uses.
+ */
+export default function XodusCatalog(): JSX.Element {
+  const { t } = useTranslation()
+  const { xodus } = useContext(ContextProvider)
+
+  const [games, setGames] = useState<GameInfo[] | null>(null)
+  const [error, setError] = useState<string | undefined>(undefined)
+  const [loading, setLoading] = useState(true)
+  const [searchText, setSearchText] = useState('')
+  const [sortDescending, setSortDescending] = useState(false)
+
+  const loadCatalog = useCallback(async () => {
+    setLoading(true)
+    setError(undefined)
+    try {
+      const result = await window.api.getXodusCatalog()
+      setGames(result.games)
+      setError(result.error)
+    } catch (err) {
+      setError(err instanceof Error ? err.message : String(err))
+    } finally {
+      setLoading(false)
+    }
+  }, [])
+
+  useEffect(() => {
+    void loadCatalog()
+  }, [loadCatalog])
+
+  const filteredAndSorted = useMemo(() => {
+    if (!games) return []
+
+    const search = searchText.trim().toLowerCase()
+    const filtered = search
+      ? games.filter((game) => game.title.toLowerCase().includes(search))
+      : games
+
+    const sorted = [...filtered].sort((a, b) => a.title.localeCompare(b.title))
+    if (sortDescending) sorted.reverse()
+    return sorted
+  }, [games, searchText, sortDescending])
+
+  const handleGameCardClick = (
+    appName: string,
+    runner: Runner,
+    gameInfo: GameInfo | null
+  ) => {
+    openInstallGameModal({ appName, runner, gameInfo })
+  }
+
+  return (
+    <div className="xodusCatalog">
+      <h5 className="xodusCatalogHeader">
+        <div className="xodusCatalogHeaderWrapper">
+          <span className="xodusCatalogTitle">
+            {t('xodus.catalog.title', 'Xbox Game Pass Catalog')}
+            {!!games?.length && (
+              <span className="numberOfgames">{filteredAndSorted.length}</span>
+            )}
+          </span>
+          <div className="xodusCatalogActions">
+            <SearchBar
+              value={searchText}
+              onInputChanged={setSearchText}
+              placeholder={t(
+                'xodus.catalog.search',
+                'Search the Game Pass catalog'
+              )}
+            />
+            <button
+              className="xodusCatalogIconButton"
+              onClick={() => setSortDescending((prev) => !prev)}
+              title={t('xodus.catalog.toggleSort', 'Toggle sort order')}
+            >
+              <FontAwesomeIcon
+                icon={sortDescending ? faArrowDownZA : faArrowDownAZ}
+              />
+            </button>
+            <button
+              className="xodusCatalogIconButton"
+              onClick={loadCatalog}
+              disabled={loading}
+              title={t('button.refresh', 'Refresh')}
+            >
+              <FontAwesomeIcon icon={faSyncAlt} spin={loading} />
+            </button>
+          </div>
+        </div>
+      </h5>
+
+      {!xodus.loggedIn && (
+        <div className="xodusCatalogLoginBanner">
+          {t(
+            'xodus.catalog.loginPrompt',
+            "You're not logged in to Xbox Game Pass yet. You can browse the catalog, but installing a title needs a login."
+          )}{' '}
+          <Link to="/login">{t('button.login', 'Login')}</Link>
+        </div>
+      )}
+
+      {loading && (
+        <UpdateComponent
+          message={t(
+            'xodus.catalog.loading',
+            'Loading the Game Pass catalog...'
+          )}
+        />
+      )}
+
+      {!loading && error && (
+        <div className="xodusCatalogError">
+          {t('xodus.catalog.error', 'Failed to load the Game Pass catalog:')}{' '}
+          {error}
+        </div>
+      )}
+
+      {!loading && !error && !filteredAndSorted.length && (
+        <div className="xodusCatalogEmpty">
+          {searchText
+            ? t('xodus.catalog.noResults', 'No titles match your search.')
+            : t('xodus.catalog.empty', 'The catalog is currently empty.')}
+        </div>
+      )}
+
+      {!loading && !error && !!filteredAndSorted.length && (
+        <GamesList
+          library={filteredAndSorted}
+          handleGameCardClick={handleGameCardClick}
+        />
+      )}
+    </div>
+  )
+}
