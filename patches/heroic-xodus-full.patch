diff --git a/src/common/types/xodus.ts b/src/common/types/xodus.ts
new file mode 100644
index 0000000..b050a1f
--- /dev/null
+++ b/src/common/types/xodus.ts
@@ -0,0 +1,118 @@
+// Types for the `xodus` store manager, which wraps `xodus-cli` (a companion
+// Rust CLI, see https://github.com/73chn1c/xodus / /home/technic/xodus) that
+// handles Xbox/Microsoft auth, Game Pass catalog browsing, downloading and
+// extracting titles, and launching them through a custom-built Wine fork
+// with a from-scratch GDK/XGameRuntime reimplementation.
+//
+// Unlike Legendary/gogdl/nile, `xodus-cli` has no `--json` output mode (as of
+// the version this integration was written against - confirmed by reading
+// crates/xodus-cli/src/commands/{library,catalog}.rs directly, not by
+// guessing). `library`/`catalog` print fixed-width, space-padded plain text
+// tables. See `parseXodusLibraryOutput` in
+// backend/storeManagers/xodus/library.ts for the parser, and its comment for
+// the exact format string each command uses.
+
+// Game Pass PC only supports Windows titles - there is no native Linux/macOS
+// build concept, everything runs through xodus's Wine fork.
+export type XodusInstallPlatform = 'Windows'
+
+/**
+ * One row of `xodus-cli library` output: a title from the logged-in
+ * account's real Xbox Live title history, decorated with the devices it has
+ * been played on and (when resolvable) its Microsoft Store product id.
+ *
+ * Mirrors `TitleEntry` + the resolved store id in
+ * crates/xodus-cli/src/commands/library.rs. `storeId` is undefined when
+ * xodus-cli printed "?" for that row (e.g. the title has no PFN, or the
+ * store id lookup failed) - such rows are not installable/launchable via
+ * `streaming`/`run` (both need a store id), so they're kept for display only.
+ */
+export interface XodusLibraryEntry {
+  name: string
+  devices: string[]
+  titleId: string
+  storeId?: string
+}
+
+/**
+ * One row of `xodus-cli catalog` output: a title currently offered by PC
+ * Game Pass (the full catalog, not just this account's history), with its
+ * resolved Microsoft Store product id. Unlike `library`, every row has a
+ * real `storeId` (it comes straight from the SIGL id list) - only the name
+ * can fail to resolve, in which case xodus-cli prints "?" for it (see
+ * `catalog.rs`).
+ */
+export interface XodusCatalogEntry {
+  name: string
+  storeId: string
+}
+
+/**
+ * Cover/logo/background art URLs (plus install size - see `sizeBytes`)
+ * resolved for a single title from Microsoft's public, unauthenticated
+ * storeedgefd product API (see `backend/storeManagers/xodus/art.ts`). Any
+ * art field may be missing if that particular image type wasn't present in
+ * the product's `Images` list.
+ */
+export interface XodusArtUrls {
+  art_cover?: string
+  art_square?: string
+  art_logo?: string
+  art_background?: string
+  /**
+   * The product's real `Payload.ApproximateSizeInBytes` - the same
+   * install-size figure Microsoft's own Store shows before you install a
+   * title. Bundled onto the same lookup as art (same API response, same
+   * cache entry) since xodus-cli itself has no way to learn a title's size
+   * ahead of downloading it (see the comment on `getInstallInfo` in
+   * library.ts) - this is an approximation from Microsoft's own listing
+   * metadata, not a measurement of the real .msixvc package.
+   */
+  sizeBytes?: number
+}
+
+export interface XodusInstallMetadataInfo {
+  id: string
+  storeId: string
+  version: string
+  path: string
+  size?: number
+  /** Absolute path to the executable last resolved from MicrosoftGame.config, passed as `xodus-cli run --exe`. */
+  executable?: string
+}
+
+interface XodusGameManifest {
+  download_size: number
+  disk_size: number
+}
+
+interface XodusGameInstallInfo {
+  id: string
+  version: string
+  path: string
+  app_name: string
+  cloud_saves_supported: boolean
+  external_activation: string
+  is_dlc: boolean
+  launch_options: []
+  owned_dlc: []
+  platform_versions: Record<XodusInstallPlatform, string>
+  title: string
+}
+
+export interface XodusInstallInfo {
+  manifest: XodusGameManifest
+  game: XodusGameInstallInfo
+}
+
+/**
+ * Minimal shape we care about from a title's `MicrosoftGame.config` (an XML
+ * file at the root of every extracted Game Pass install). Used to resolve
+ * the right `--exe` to pass to `xodus-cli run`, working around a real
+ * xodus-cli bug where `run`'s own default-exe-picking isn't reliable for
+ * titles with multiple executables.
+ */
+export interface MicrosoftGameConfigExecutable {
+  Name: string
+  Id?: string
+}
