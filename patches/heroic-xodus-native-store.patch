+import { StoreManager } from '../storeManager'
+import { GameInfo } from '../../../common/types'
+import { XodusDetector } from 'xodus-for-heroic'
+
+export class XodusStoreManager extends StoreManager {
+  public storeName = 'xodus'
+
+  public async getLibrary(): Promise<GameInfo[]> {
+    const games = XodusDetector.scanStandardDirectories()
+    return games.map((game) => ({
+      app_name: game.titleId || game.displayName,
+      title: game.displayName,
+      runner: 'proton',
+      install: {
+        is_installed: true,
+        install_path: game.gameDirectory,
+        executable: game.executableName,
+        version: game.version || '1.0.0'
+      }
+    }))
+  }
+}
